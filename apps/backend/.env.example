# ==========================================
# 🏰 CASTLEWEB Backend Configuration (.env)
# ==========================================

# Application
APP_ENV=development
APP_NAME="CASTLEWEB API"
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://castleweb.ru"
SECRET_KEY="super-secret-castleweb-key-change-in-production"

# Database
# For local dev without Postgres running, defaults to SQLite: sqlite+aiosqlite:///./castleweb.db
# For Docker / Production: postgresql+asyncpg://castleweb_user:castleweb_secret_pass@postgres:5432/castleweb_db
DATABASE_URL="sqlite+aiosqlite:///./castleweb.db"

# Redis (Cache, Rate limiting, Queue)
REDIS_URL="redis://localhost:6379/0"

# Telegram Bot & Notifications (Headless CRM)
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_team_chat_id_here"
# Optional Cloudflare Worker Proxy for Telegram API to bypass network throttling/blocks
# Example: https://tg-proxy.your-subdomain.workers.dev/bot
TELEGRAM_API_BASE_URL="https://api.telegram.org/bot"

# Cloudflare Turnstile (Anti-Spam Captcha)
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
CLOUDFLARE_TURNSTILE_ENABLED=False

# S3 / Cloudflare R2 File Storage (100% Free Tier)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="castleweb-uploads"
R2_PUBLIC_DOMAIN=""

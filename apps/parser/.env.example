# ====================================================================
# LeadHunter Pro & FL.ru Parser Environment Configuration
# ====================================================================

# Токен вашего Telegram-бота (получите у @BotFather в Telegram)
# Пример: TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# Авторассылка новых заказов с фриланс-бирж в Telegram (бот и заявки работают независимо)
FREELANCE_ORDER_NOTIFICATIONS_ENABLED=false

# Реверс-прокси Cloudflare Worker для обхода блокировок Telegram API без VPN
# Пример: TELEGRAM_API_SERVER=https://jolly-haze-c6cf.eprof6682-3e3.workers.dev
TELEGRAM_API_SERVER=

# Опционально: SOCKS5 / HTTP Прокси (если не используется Cloudflare Worker)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Хост и порт для запуска FastAPI бэкенда (по умолчанию 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000

# ====================================================================
# Безопасность и Аутентификация (HTTP-Only Cookie + JWT)
# ====================================================================
# Секретный ключ для подписи сессионных токенов (сгенерируйте: openssl rand -hex 32)
# Generate a unique key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Обязательный уникальный секрет связи с основным backend (тот же, что у backend)
INTERNAL_API_SECRET=

# Флаг Secure для Cookie: 'true' при работе за HTTPS (Cloudflare), 'false' только для локальной отладки
COOKIE_SECURE=true

# Необязательные уникальные реквизиты первого администратора.
# Оставьте пустыми и создайте администратора локально через manage_users.py,
# либо задайте уникальный пароль длиной не менее 14 символов до первого запуска.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ====================================================================
# AI SDR & Telegram Outreach (CastleWeb)
# ====================================================================
# Токен отдельного Telegram-бота для управления AI SDR, автоответчиком и тестами
# (Создайте отдельного бота у @BotFather, например @MyOutreachAdminBot)
OUTREACH_BOT_TOKEN=

# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Whitelist Telegram ID администраторов для панели управления (через запятую)
# Пример: ADMIN_TELEGRAM_IDS=12345678,87654321
ADMIN_TELEGRAM_IDS=


# ID чата/группы для P0-алертов менеджерам о горячих лидах
MANAGER_TELEGRAM_CHAT_ID=

# Telegram API ID & Hash для рабочих MTProto-аккаунтов (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Лимиты и рабочие часы (МСК)
OUTREACH_DAILY_LIMIT=18
OUTREACH_MIN_DELAY_SECONDS=300
OUTREACH_MAX_DELAY_SECONDS=900
OUTREACH_WORK_HOURS_START=10
OUTREACH_WORK_HOURS_END=18
